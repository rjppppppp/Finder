<Window x:Class="FinderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FinderApp.Controls"
        xmlns:models="clr-namespace:FinderApp.Models"
        mc:Ignorable="d"
        Title="Finder"
        Icon="finder.png"
        Width="720"
        MinHeight="58"
        MaxHeight="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Custom ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#475569">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#475569" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item Context Menu -->
        <ContextMenu x:Key="ItemContextMenu" Background="#161924" BorderBrush="#2A3247" BorderThickness="1">
            <MenuItem Header="📋 Copy Full Path" Click="ContextMenu_CopyPath_Click" Foreground="#FFFFFF" InputGestureText="Ctrl+C"/>
            <MenuItem Header="📁 Open Containing Folder" Click="ContextMenu_OpenFolder_Click" Foreground="#FFFFFF" InputGestureText="Ctrl+Enter"/>
            <Separator Background="#252D3F"/>
            <MenuItem Header="🚀 Open / Launch" Click="ContextMenu_Launch_Click" Foreground="#FFFFFF" InputGestureText="Enter"/>
        </ContextMenu>

        <!-- ListBoxItem Template -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="12,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252A38"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B4254"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A3147"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Date Filter Pill Button Style -->
        <Style x:Key="DatePillStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Background" Value="#1A1F2C"/>
            <Setter Property="BorderBrush" Value="#293246"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="pillText"
                                       Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#252D42"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="pillText" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme DatePicker -->
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#171B28"/>
            <Setter Property="BorderBrush" Value="#2E374D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Background" Value="#171B28"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Date Filter Button Style -->
        <Style x:Key="DateFilterBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#181D2A"/>
            <Setter Property="BorderBrush" Value="#29334A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#242D40"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Container with Rounded Corners, Draggable Anywhere -->
    <Border CornerRadius="18"
            Background="#161821"
            BorderBrush="#2C3246"
            BorderThickness="1.2"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Search Box -->
                <RowDefinition Height="Auto"/> <!-- 1. Date Filter Panel -->
                <RowDefinition Height="Auto"/> <!-- 2. Category Filter Bar -->
                <RowDefinition Height="*"/>    <!-- 3. Results List -->
                <RowDefinition Height="Auto"/> <!-- 4. Status & Shortcuts Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Search Box Area (Draggable) -->
            <Border Grid.Row="0"
                    Padding="18,14"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#232736"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Search Icon -->
                        <ColumnDefinition Width="*"/>    <!-- Input -->
                        <ColumnDefinition Width="Auto"/> <!-- Date Filter Button -->
                        <ColumnDefinition Width="Auto"/> <!-- Clear Button -->
                        <ColumnDefinition Width="Auto"/> <!-- Shortcut Badge -->
                        <ColumnDefinition Width="Auto"/> <!-- Close Button -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Icon SVG -->
                    <Path Grid.Column="0"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          Fill="#38BDF8"
                          Data="M 9.5 3 C 5.91 3 3 5.91 3 9.5 C 3 13.09 5.91 16 9.5 16 C 11.08 16 12.53 15.43 13.66 14.49 L 18.59 19.41 C 18.98 19.8 19.61 19.8 20 19.41 C 20.39 19.02 20.39 18.39 20 18 L 15.07 13.07 C 16.01 11.94 16.58 10.49 16.58 8.91 C 16.58 5.32 13.67 2.41 10.08 2.41 C 10.08 2.41 9.5 3 9.5 3 Z M 9.5 5 C 11.99 5 14 7.01 14 9.5 C 14 11.99 11.99 14 9.5 14 C 7.01 14 5 11.99 5 9.5 C 5 7.01 7.01 5 9.5 5 Z"/>

                    <!-- Search Input and Placeholder -->
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="PlaceholderText"
                                   Text="Search files, apps, and more..."
                                   Foreground="#64748B"
                                   FontSize="17"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FFFFFF"
                                 CaretBrush="#38BDF8"
                                 FontSize="17"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>

                    <!-- Date Filter Toggle Button -->
                    <Button x:Name="DateFilterButton"
                            Style="{StaticResource DateFilterBtnStyle}"
                            Grid.Column="2"
                            Height="26"
                            Margin="6,0,2,0"
                            Cursor="Hand"
                            ToolTip="Filter by Date (Ctrl+D)"
                            Click="DateFilterButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DateFilterButtonText" Text="Date" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DateFilterChevron" Text="▾" FontSize="9" Margin="4,0,0,0" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Clear Button -->
                    <Button x:Name="ClearButton"
                            Grid.Column="3"
                            Width="24"
                            Height="24"
                            Margin="6,0"
                            Background="#272D3D"
                            Foreground="#94A3B8"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="ClearButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <TextBlock Text="✕" FontSize="11" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Shortcut Pill -->
                    <Border Grid.Column="4"
                            Background="#1E2333"
                            BorderBrush="#2F364C"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ShortcutBadge"
                                   Text="Alt + Space"
                                   Foreground="#38BDF8"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Window Close Button -->
                    <Button x:Name="WindowCloseButton"
                            Grid.Column="5"
                            Width="26"
                            Height="26"
                            Margin="8,0,0,0"
                            Background="#222838"
                            Foreground="#94A3B8"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Close (Alt+Space to show again)"
                            Click="WindowCloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                    <TextBlock Text="✕" FontSize="11" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Date Filter Drawer / Panel (Toggleable: Presets + Custom Date Range) -->
            <Border x:Name="DateFilterPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#131622"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#212534"
                    Padding="14,8">
                <StackPanel>
                    <!-- Quick Presets Row -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Date:" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <Button x:Name="DatePreset_All" Tag="All" Content="✨ All Time" Click="DatePreset_Click" Style="{StaticResource DatePillStyle}"/>
                        <Button x:Name="DatePreset_Today" Tag="Today" Content="⚡ Today" Click="DatePreset_Click" Style="{StaticResource DatePillStyle}"/>
                        <Button x:Name="DatePreset_7Days" Tag="7Days" Content="🕒 Past 7 Days" Click="DatePreset_Click" Style="{StaticResource DatePillStyle}"/>
                        <Button x:Name="DatePreset_30Days" Tag="30Days" Content="📆 Past 30 Days" Click="DatePreset_Click" Style="{StaticResource DatePillStyle}"/>
                        <Button x:Name="DatePreset_ThisYear" Tag="ThisYear" Content="🗓️ This Year" Click="DatePreset_Click" Style="{StaticResource DatePillStyle}"/>
                        <Button x:Name="DatePreset_Custom" Tag="Custom" Content="🎯 Custom Range..." Click="DatePreset_Click" Style="{StaticResource DatePillStyle}"/>

                        <Button x:Name="ClearDateFilterButton"
                                Content="✕ Reset"
                                Margin="8,0,0,0"
                                Padding="6,2"
                                Background="Transparent"
                                Foreground="#F43F5E"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Click="ClearDateFilter_Click"/>
                    </StackPanel>

                    <!-- Custom Date Range Picker Bar -->
                    <Border x:Name="CustomDateRangeBar"
                            Visibility="Collapsed"
                            Margin="0,8,0,0"
                            Padding="10,6"
                            Background="#181D2C"
                            BorderBrush="#27324B"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Target Range:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <TextBlock Text="From:" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <DatePicker x:Name="FromDatePicker" Width="125" Height="25" SelectedDateChanged="CustomDatePicker_SelectedDateChanged"/>

                            <TextBlock Text="To:" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <DatePicker x:Name="ToDatePicker" Width="125" Height="25" SelectedDateChanged="CustomDatePicker_SelectedDateChanged"/>

                            <Button Content="✓ Apply"
                                    Margin="10,0,0,0"
                                    Padding="10,3"
                                    Background="#0284C7"
                                    Foreground="#FFFFFF"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ApplyCustomDate_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="applyBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="applyBorder" Property="Background" Value="#0369A1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Category Filter Bar (Slidable via drag, wheel, or arrow buttons) -->
            <Border x:Name="CategoryBar"
                    Grid.Row="2"
                    Padding="10,6"
                    Background="#12141C"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#212533"
                    PreviewMouseWheel="CategoryScrollViewer_PreviewMouseWheel"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Scroll Left button -->
                        <ColumnDefinition Width="*"/>    <!-- Scrollable container -->
                        <ColumnDefinition Width="Auto"/> <!-- Scroll Right button -->
                    </Grid.ColumnDefinitions>

                    <!-- Scroll Left Button -->
                    <Button Grid.Column="0"
                            Width="22"
                            Height="28"
                            Margin="0,0,6,0"
                            Background="#1E2333"
                            Foreground="#94A3B8"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Slide Left"
                            Click="CategoryScrollLeft_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock x:Name="txt" Text="‹" FontSize="17" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2D354D"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="#38BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ScrollViewer with Drag-to-Slide and Mouse Wheel Slide -->
                    <ScrollViewer x:Name="CategoryScrollViewer"
                                  Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  PanningMode="HorizontalOnly"
                                  PreviewMouseWheel="CategoryScrollViewer_PreviewMouseWheel"
                                  PreviewMouseDown="CategoryScrollViewer_PreviewMouseDown"
                                  PreviewMouseMove="CategoryScrollViewer_PreviewMouseMove"
                                  PreviewMouseUp="CategoryScrollViewer_PreviewMouseUp">
                        <ItemsControl x:Name="CategoryItemsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CategoryCount}">
                                    <Button Margin="0,0,6,0"
                                            Padding="10,5"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding BorderBrush}"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Click="CategoryButton_Click"
                                            Tag="{Binding Name}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Foreground}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Scroll Right Button -->
                    <Button Grid.Column="2"
                            Width="22"
                            Height="28"
                            Margin="6,0,0,0"
                            Background="#1E2333"
                            Foreground="#94A3B8"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Slide Right"
                            Click="CategoryScrollRight_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock x:Name="txt" Text="›" FontSize="17" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2D354D"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="#38BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 4. Results List -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="3"
                     MaxHeight="380"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.ScrollChanged="ResultsList_ScrollChanged"
                     PreviewMouseWheel="ResultsList_PreviewMouseWheel"
                     PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="20,20"
                     VirtualizingPanel.CacheLengthUnit="Item"
                     Padding="12,6"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SearchResultItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                <ColumnDefinition Width="*"/>    <!-- Name & Path -->
                                <ColumnDefinition Width="Auto"/> <!-- Badges -->
                            </Grid.ColumnDefinitions>

                            <!-- File/Folder Icon -->
                            <Image Grid.Column="0"
                                   Source="{Binding Icon}"
                                   Width="26"
                                   Height="26"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Name with Highlighting & Directory Path -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <controls:HighlightedTextBlock
                                    FullText="{Binding Name}"
                                    HighlightIndices="{Binding HighlightIndices}"
                                    FontSize="14"
                                    FontWeight="Normal"/>

                                <TextBlock Text="{Binding DirectoryPath}"
                                           Foreground="#64748B"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Metadata & Actions Column (Strict Tabular Alignment) -->
                            <Grid Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <!-- Match Tag (Typo / Acronym - collapses to 0 width for exact matches) -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Category Pill (Fixed width for 100% vertical symmetry) -->
                                    <ColumnDefinition Width="80"/>
                                    <!-- Modified Date (Clean right-aligned) -->
                                    <ColumnDefinition Width="68"/>
                                    <!-- File Size (Fixed width, strictly right-aligned) -->
                                    <ColumnDefinition Width="54"/>
                                    <!-- Copy Path Action Button (Fixed position) -->
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. Subtle Match Type Tag (~ Typo / ⚡ Acronym) -->
                                <Border Grid.Column="0"
                                        Visibility="{Binding MatchTagVisibility}"
                                        Background="#261A0F"
                                        BorderBrush="#4D361B"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="5,2"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MatchDisplayTag}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#F59E0B"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- 2. Uniform Category Badge -->
                                <Border Grid.Column="1"
                                        Width="76"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Background="#181F2E"
                                        BorderBrush="#29334A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryIcon}"
                                                   FontSize="11"
                                                   Foreground="#FFFFFF"
                                                   Margin="0,0,4,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="#93C5FD"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Clean Right-Aligned Modified Date -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DateText}"
                                           Foreground="#64748B"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           Margin="0,0,6,0"/>

                                <!-- 4. Clean Right-Aligned File Size -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding SizeText}"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           Margin="0,0,6,0"/>

                                <!-- 5. Sleek Copy Path Button -->
                                <Button Grid.Column="4"
                                        Width="26"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#161D2B"
                                        BorderBrush="#252E44"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        ToolTip="Copy Full Path (Ctrl+C)"
                                        Click="CopyPathButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <TextBlock x:Name="t" Text="📋" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#25324D"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/>
                                                    <Setter TargetName="t" Property="Foreground" Value="#38BDF8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 5. Status and Shortcuts Footer (Draggable) -->
            <Border Grid.Row="4"
                    Padding="16,8"
                    Background="#11131A"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#1E2230"
                    CornerRadius="0,0,17,17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Indexed status & Reindex -->
                        <ColumnDefinition Width="*"/>    <!-- Spacing -->
                        <ColumnDefinition Width="Auto"/> <!-- Keyboard hints -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Indexing files in background..."
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <!-- Manual Reindex Button -->
                        <Button x:Name="ReindexButton"
                                Margin="10,0,0,0"
                                Padding="6,2"
                                Background="#1A202C"
                                BorderBrush="#2D3748"
                                BorderThickness="1"
                                Cursor="Hand"
                                ToolTip="Reindex all drives and files (Ctrl+R)"
                                Click="ReindexButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="↻" FontSize="11" Foreground="#38BDF8" Margin="0,0,4,0" FontWeight="Bold"/>
                                            <TextBlock Text="Reindex" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#252D3D"/>
                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Quit App Button -->
                        <Button x:Name="QuitButton"
                                Margin="6,0,0,0"
                                Padding="6,2"
                                Background="#1A202C"
                                BorderBrush="#2D3748"
                                BorderThickness="1"
                                Cursor="Hand"
                                ToolTip="Quit Finder completely (Ctrl+Q)"
                                Click="QuitButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnQuitBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="✕ Exit" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnQuitBorder" Property="Background" Value="#3B1D28"/>
                                            <Setter TargetName="btnQuitBorder" Property="BorderBrush" Value="#F43F5E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+D Date" Foreground="#38BDF8" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="Ctrl+C Copy" Foreground="#64748B" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="Ctrl+R Reindex" Foreground="#64748B" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="↵ Open" Foreground="#CBD5E1" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="Ctrl+↵ Folder" Foreground="#94A3B8" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="Esc Hide" Foreground="#64748B" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="Ctrl+Q Exit" Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
